{
  "name": "docs-landing",
  "version": "0.1.0",
  "private": true,
  "description": "DocsHunt landing and blog mirror built with Next.js.",
  "author": "DocsHunt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ys970605-boop/docs-landing.git"
  },
  "homepage": "https://github.com/ys970605-boop/docs-landing",
  "bugs": {
    "url": "https://github.com/ys970605-boop/docs-landing/issues"
  },
  "keywords": [
    "docshunt",
    "landing-page",
    "blog-mirror",
    "nextjs",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:host": "next dev -H 0.0.0.0 -p 3001",
    "build": "next build",
    "build:strict": "npm run validate && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "next start -p 3001",
    "lint": "eslint --max-warnings=0 .",
    "type-check": "tsc --noEmit --pretty false",
    "typecheck": "npm run type-check",
    "validate": "npm run lint && npm run type-check",
    "precommit": "npm run type-check && npm run lint && npm run format:check",
    "prepare": "node scripts/install-git-hooks.mjs",
    "check": "npm run precommit && npm run build"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
